{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build", "^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"],
      "passThroughEnv": ["NODE_ENV", "DATABASE_URL"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    }
  }
}
